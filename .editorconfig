root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# YAML в репозитории написан с отступом в 2 пробела
[*.{yml,yaml}]
indent_size = 2

# В markdown два пробела в конце строки значимы (перенос строки)
[*.md]
trim_trailing_whitespace = false
