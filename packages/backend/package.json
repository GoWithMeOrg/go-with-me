{
    "name": "@go-with-me/backend",
    "version": "0.0.1",
    "private": true,
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "build": "nest build",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.build.json --noEmit",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main.js",
        "test": "node --disable-warning=ExperimentalWarning --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:watch": "node --disable-warning=ExperimentalWarning --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
        "test:cov": "node --disable-warning=ExperimentalWarning --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
        "test:debug": "node --inspect-brk --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
        "test:e2e": "node --disable-warning=ExperimentalWarning --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests --testRegex '.*\\.e2e-spec\\.ts$'"
    },
    "dependencies": {
        "@apollo/server": "^5.5.1",
        "@as-integrations/express5": "^1.1.2",
        "@aws-sdk/client-s3": "^3.1163.0",
        "@aws-sdk/s3-request-presigner": "^3.1163.0",
        "@nestjs/apollo": "^14.2.0",
        "@nestjs/common": "^12.4.0",
        "@nestjs/config": "^12.1.1",
        "@nestjs/core": "^12.4.0",
        "@nestjs/graphql": "^14.2.0",
        "@nestjs/mongoose": "^12.0.1",
        "@nestjs/passport": "^12.0.1",
        "@nestjs/platform-express": "^12.4.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "connect-mongo": "^6.0.0",
        "cookie": "^2.0.2",
        "cookie-signature": "^1.2.2",
        "express": "^5.3.0",
        "express-session": "^1.19.0",
        "graphql": "catalog:",
        "graphql-subscriptions": "^3.0.0",
        "graphql-ws": "catalog:",
        "mongoose": "^9.12.0",
        "nanoid": "^6.0.2",
        "nestjs-pino": "^5.3.1",
        "nestjs-s3": "^3.0.1",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "pino": "^10.4.0",
        "pino-http": "^11.0.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@nestjs/cli": "^12.0.12",
        "@nestjs/schematics": "^12.0.13",
        "@nestjs/testing": "^12.4.0",
        "@types/cookie-signature": "^1.1.2",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.19.0",
        "@types/jest": "^30.0.0",
        "@types/node": "catalog:",
        "@types/passport": "^1.0.17",
        "@types/passport-google-oauth20": "^2.0.17",
        "jest": "^30.5.2",
        "pino-pretty": "^13.2.0",
        "ts-jest": "^29.4.15",
        "typescript": "catalog:"
    },
    "type": "module"
}
