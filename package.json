{
    "name": "go-with-me",
    "private": true,
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": ">=26"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "pnpm --filter \"*\" build",
        "backend:dev": "pnpm --filter backend nest start --watch",
        "frontend:dev": "pnpm -C packages/frontend dev",
        "lint": "eslint packages/frontend packages/backend",
        "frontend:lint": "eslint packages/frontend --fix",
        "backend:lint": "eslint packages/backend --fix",
        "typegen": "pnpm -C packages/frontend exec next typegen",
        "typecheck": "pnpm typecheck:backend && pnpm typecheck:frontend",
        "typecheck:backend": "pnpm -C packages/backend exec tsc -p tsconfig.build.json --noEmit",
        "typecheck:frontend": "pnpm typegen && pnpm -C packages/frontend exec tsc --noEmit",
        "check:codegen": "pnpm codegen && git diff --exit-code -- packages/backend/src/schema packages/frontend/src/app/graphql",
        "frontend:format": "prettier packages/frontend -w",
        "backend:format": "prettier packages/backend -w",
        "import:mongo": "./scripts/import-mongo-data.sh",
        "codegen": "graphql-codegen --config codegen.ts"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@graphql-codegen/cli": "^8.0.0",
        "@graphql-codegen/typed-document-node": "^8.0.0",
        "@graphql-codegen/typescript": "^7.0.0",
        "@graphql-codegen/typescript-operations": "^7.0.0",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@playwright/test": "^1.64.1",
        "eslint": "^10.14.0",
        "eslint-config-next": "^16.4.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-storybook": "^10.6.5",
        "globals": "^17.14.0",
        "prettier": "^3.9.10",
        "typescript": "catalog:",
        "typescript-eslint": "^8.72.1"
    }
}
